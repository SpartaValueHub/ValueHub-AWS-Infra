# Copy to Apps EC2 as /opt/valuehub-aws-infra/.env
#   cp env/apps.env.example .env

IMAGE_TAG=prod

# --- DB EC2 (use private IP in same VPC) ---
MYSQL_HOST=172.31.x.x
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=change-me-strong

MONGODB_HOST=172.31.x.x
MONGODB_USERNAME=admin
MONGODB_PASSWORD=change-me-strong
MONGODB_DATABASE=chatting_db
MONGODB_REPLICA_SET=rs0

# --- Gateway / Auth ---
SECURITY_JWT_ENABLED=true
AUTH_COOKIE_ACCESS_NAME=vh_access_token
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14

# Vercel frontend origin(s), comma-separated
AUTH_ALLOWED_ORIGINS=https://your-app.vercel.app

PORTONE_API_SECRET=
CI_HASH_KEY=
CAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
