# DB EC2 .env — also set advertise host for replica set member
MYSQL_ROOT_PASSWORD=change-me-strong
MYSQL_DATABASE=auth_db

MONGODB_USERNAME=admin
MONGODB_PASSWORD=change-me-strong
MONGODB_DATABASE=chatting_db
MONGODB_REPLICA_SET=rs0

# IMPORTANT: use this DB EC2 private IP (same value Apps EC2 will use as MONGODB_HOST)
MONGODB_ADVERTISE_HOST=172.31.x.x
